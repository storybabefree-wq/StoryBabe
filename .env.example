# ==========================================
# StoryBabe Root & Global Environment Variables
# ==========================================

# Security Secrets (Generate random strings for production)
JWT_SECRET=storybabe-production-secure-jwt-secret-key-2026
INTERNAL_SERVICE_SECRET=storybabe-internal-microservice-signature-secret-xyz987

# Database Connection (Optional for PostgreSQL in production; defaults to SQLite data/storybabe.db)
# DATABASE_URL=postgresql://user:password@host:5432/storybabe?sslmode=require

# Transactional Email Service Option 1: Gmail SMTP (100% FREE with Google App Password - No domain needed!)
# Generate in: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=
SMTP_PASS=

# Transactional Email Service Option 2: Resend API (Requires custom domain to send to any recipient)
RESEND_API_KEY=
RESEND_FROM_EMAIL=StoryBabe <onboarding@resend.dev>

# AI Image Generation (Optional: add your OpenRouter API key)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1-schnell

# Frontend API URL (Used by Next.js in apps/web/.env.local)
# Local: http://localhost:4000/api/v1
# Production: https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
